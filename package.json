  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "main": "./dist/editor.umd.js",
  "module": "./dist/editor.js",
  "imports": {
    "#/*": "./test/*"
  },
  "exports": {
    ".": {
      "import": "./dist/editor.js",
      "require": "./dist/editor.umd.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "coverage": "vitest run --coverage",
    "dev": "concurrently \"vite --host --force\" \"pnpm build --watch\" \"pnpm preview -l silent --host\"",
    "dev:multiplayer": "concurrently \"vite\" \"pnpm multiplayer\"",
    "dev:test": "concurrently \"vite --port 5174\" \"pnpm multiplayer\"",
    "fix": "pnpm store prune && rm -rf node_modules && pnpm install",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && node scripts/check-test-skips.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix .",
    "main": "git checkout main && git pull ${INKLING_UPSTREAM:-origin} main && pnpm install",
    "multiplayer": "HOST=localhost PORT=1234 npx y-websocket-server",
    "precoverage": "pnpm build",
    "prepare": "husky .github/hooks",
    "presetup": "pnpm install",
    "pretest": "VITE_TEST=true pnpm build --config vite.config.demo.ts && pnpm build",
    "pretest:unit": "pnpm build",
    "pretest:watch": "pnpm pretest",
    "preview": "vite preview --outDir dist-demo",
    "setup": "pnpm install && pnpm build",
    "storybook": "NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 6006 -h 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' VITE_TEST=true playwright test",
    "test:e2e:headed": "PLAYWRIGHT_HEADED=true pnpm test:e2e",
    "test:e2e:quiet": "pnpm test:e2e --reporter=line",
    "test:e2e:report": "PLAYWRIGHT_HTML_REPORT=true pnpm test:e2e",
    "test:slowmo": "TIMEOUT=100000 PLAYWRIGHT_SLOWMO=100 pnpm test:e2e:headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
